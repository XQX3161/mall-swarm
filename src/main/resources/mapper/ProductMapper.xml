<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.macro.common.mapper.ProductMapper">

    <resultMap id="ProductResultMap" type="com.macro.common.entity.Product">
        <id property="id" column="id" />
        <result property="name" column="name" />
        <result property="sku" column="sku" />
        <result property="description" column="description" />
        <result property="price" column="price" />
        <result property="stock" column="stock" />
        <result property="status" column="status" />
        <result property="createdAt" column="created_at" />
        <result property="updatedAt" column="updated_at" />
    </resultMap>

    <sql id="Base_Column_List">
        id, name, sku, description, price, stock, status, created_at, updated_at
    </sql>

    <insert id="insert" parameterType="com.macro.common.entity.Product" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO `product` (name, sku, description, price, stock, status, created_at, updated_at)
        VALUES (#{name}, #{sku}, #{description}, #{price}, #{stock}, #{status}, #{createdAt}, #{updatedAt})
    </insert>

    <update id="updateById" parameterType="com.macro.common.entity.Product">
        UPDATE `product` SET
        name = #{name},
        sku = #{sku},
        description = #{description},
        price = #{price},
        stock = #{stock},
        status = #{status},
        updated_at = #{updatedAt}
        WHERE id = #{id}
    </update>

    <delete id="deleteById" parameterType="long">
        DELETE FROM `product` WHERE id = #{id}
    </delete>

    <select id="selectById" parameterType="long" resultMap="ProductResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM `product` WHERE id = #{id}
    </select>

    <select id="selectAll" resultMap="ProductResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM `product` ORDER BY id DESC
    </select>

</mapper>
